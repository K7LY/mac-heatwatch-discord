<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.k7ly.mac-heatwatch-discord</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__PROJECT_DIR__/src/mac_heat_watch.py</string>
  </array>

  <key>StartInterval</key>
  <integer>__START_INTERVAL__</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/mac-heat-watch/launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/mac-heat-watch/launchd.err.log</string>
</dict>
</plist>
